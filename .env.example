# ---------------------------------------------------------------------------
# Adaptive AI Learning Platform — environment configuration template
# Copy to `.env.local` (dev) or provide via your secret manager (prod).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/adaptiq

# --- Runtime ---------------------------------------------------------------
# Set automatically by Next.js ("development" | "production" | "test").
# NODE_ENV=production
# Shown on the health endpoint for release correlation.
# APP_VERSION=0.0.0

# --- Logging / observability ----------------------------------------------
# LOG_LEVEL=info                 # debug | info | warn | error
# METRICS_TOKEN=                 # REQUIRED in production: Bearer token guarding
#                                # /api/metrics. If unset in production the
#                                # metrics endpoint fails closed (see P2-4).
# SLOW_QUERY_MS=200              # Log queries slower than this many ms.

# --- Networking / rate limiting -------------------------------------------
# Number of TRUSTED reverse proxies in front of the app (CDN + LB = 2, a single
# nginx = 1). Used to pick the real, non-spoofable client IP from
# X-Forwarded-For. Default 0 resolves to the nearest-proxy-observed IP (correct
# behind a single proxy). Set to your real hop count in multi-proxy setups.
# TRUSTED_PROXY_COUNT=1
# Per-key rate-limit overrides (defaults shown). Windows are in milliseconds.
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_MS=300000
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW_MS=3600000
# RATE_LIMIT_MUTATION_MAX=240
# RATE_LIMIT_MUTATION_WINDOW_MS=60000

# --- Database connection pool ---------------------------------------------
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_TIMEOUT_MS=10000

# --- Demo data seeding -----------------------------------------------------
# Outside production the demo dataset auto-seeds an empty database (dev/preview
# convenience). In PRODUCTION auto-seeding is DISABLED unless you explicitly opt
# in, and it will NOT create accounts with a default password.
# ALLOW_DEMO_SEED=false          # set "true" to permit demo seeding in prod
# SEED_PASSWORD=                 # REQUIRED (>= 12 chars) when seeding in prod;
#                                # sets the password for all seeded demo accounts

# --- AI Tutor LLM adapter (optional) --------------------------------------
# When unset, the tutor uses its deterministic offline fallback generator.
# TUTOR_LLM_PROVIDER=            # e.g. openai-compatible
# TUTOR_LLM_BASE_URL=
# TUTOR_LLM_API_KEY=
# TUTOR_LLM_MODEL=
# TUTOR_LLM_TIMEOUT_MS=8000
